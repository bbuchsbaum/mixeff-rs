+    /// Express this quadratic around a centre displaced by `step`.
+    ///
+    /// If q(s) = g's + 1/2 s'Hs around x, then around x+d the same
+    /// quadratic has gradient g + Hd and Hessian H. The constant term is not
+    /// represented here; callers anchor it to the newly evaluated objective.
+    fn translated(&self, step: &[f64]) -> Self {
+        let displacement = DVector::from_column_slice(step);
+        Self {
+            gradient: &self.gradient + &self.hessian * displacement,
+            hessian: self.hessian.clone(),
+            sample_count: self.sample_count,
+        }
+    }
