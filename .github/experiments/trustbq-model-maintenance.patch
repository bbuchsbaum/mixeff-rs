+    #[test]
+    fn trust_bq_model_maintenance_reduces_evaluations_without_moving_the_solution() {
+        // The sinusoidal term vanishes at the initial finite-difference
+        // stencil but bends the objective between stencil points. This causes
+        // a rejected interior trial and exercises contraction-time model reuse.
+        fn curved(x: &[f64]) -> Result<f64> {
+            let base = 2.0 * x[0] * x[0] - x[0];
+            Ok(base + (std::f64::consts::PI * x[0]).sin().powi(2))
+        }
+
+        let options = |maintain| TrustBqOptions {
+            initial_radius: 1.0,
+            final_radius: 1e-7,
+            max_evaluations: 2000,
+            ftol_abs: 1e-12,
+            ftol_rel: 1e-12,
+            max_rejected_model_reuses: usize::from(maintain),
+            max_accepted_model_reuses: usize::from(maintain),
+            ..TrustBqOptions::default()
+        };
+        let rebuilt = minimize(&[0.0], &[-2.0], &[2.0], options(false), curved).unwrap();
+        let maintained = minimize(&[0.0], &[-2.0], &[2.0], options(true), curved).unwrap();
+
+        assert!(rebuilt.stop_reason.is_acceptable_convergence(), "{rebuilt:?}");
+        assert!(maintained.stop_reason.is_acceptable_convergence(), "{maintained:?}");
+        assert!(
+            (maintained.fmin - rebuilt.fmin).abs() < 1e-8,
+            "objective drift: {rebuilt:?} vs {maintained:?}"
+        );
+        assert!(
+            (maintained.x[0] - rebuilt.x[0]).abs() < 1e-4,
+            "solution drift: {rebuilt:?} vs {maintained:?}"
+        );
+        assert!(
+            maintained.fevals < rebuilt.fevals,
+            "model maintenance did not save evaluations: {rebuilt:?} vs {maintained:?}"
+        );
+    }
